# Salin file ini menjadi ".env" lalu isi nilainya, kemudian jalankan: php artisan key:generate
# File .env TIDAK boleh di-commit (sudah ada di .gitignore bawaan Laravel).

APP_NAME=KasKu
# local untuk komputer sendiri, production untuk hosting
APP_ENV=local
# Diisi otomatis oleh: php artisan key:generate
APP_KEY=
# Di hosting WAJIB false (jika true, pesan error detail bocor ke pengunjung)
APP_DEBUG=true
APP_URL=http://localhost/kasku-laravel/public

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database (XAMPP lokal: user root, password kosong. Di hosting pakai user khusus)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kasku_laravel
DB_USERNAME=root
DB_PASSWORD=
# Database cloud (mis. TiDB Cloud) mewajibkan TLS: isi path sertifikat CA.
# Di Vercel diisi otomatis oleh api/index.php (jangan diisi di dasbor). Lokal: biarkan kosong untuk MySQL XAMPP.
MYSQL_ATTR_SSL_CA=
# Hanya di belakang reverse proxy (Vercel): isi *. Lokal biarkan kosong.
TRUSTED_PROXIES=

# Sesi disimpan di database (tabel "sessions") agar sesi bisa dicabut saat akun
# dinonaktifkan atau password diganti.
SESSION_DRIVER=database
# Masa berlaku sesi tanpa aktivitas, dalam MENIT
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Di hosting (HTTPS) ubah menjadi true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
# Email tidak dipakai aplikasi ini (tidak ada fitur kirim email).
MAIL_MAILER=log tidak ada email yang dikirim: fitur "Lupa password"
# tetap berfungsi lewat daftar permintaan di halaman admin. Untuk mengirim tautan reset lewat email,
# isi data SMTP dari layanan email pilihanmu dan ganti MAIL_MAILER=smtp. Isi rahasia ini hanya di
# .env / Environment Variables hosting, jangan di kode.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="KasKu"

# Password akun demo untuk seeder (opsional, minimal 8 karakter, ada huruf dan angka).
# Kosongkan agar seeder membuat password acak dan menampilkannya sekali di terminal.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600
